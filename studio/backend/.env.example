# =============================================================================
# VYOM Studio — backend environment template
# Copy to .env and fill in your keys:  cp .env.example .env
# =============================================================================

# --- App / server ---
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
DISABLE_OPENAPI=

# --- Google (Gemini text + Imagen) ---
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_SCENE_PROMPT_MODEL=gemini-2.5-flash-lite

# --- Anthropic (Claude — story engine) ---
ANTHROPIC_API_KEY=your_claude_api_key_here

# --- OpenAI (optional Scene Prompt Studio) ---
OPENAI_API_KEY=your_openai_sk_proj_key_here
OPENAI_SCENE_PROMPT_MODEL=gpt-4o-mini

# --- TokenLB (story / LLM fallback) ---
TOKENLB_API_KEY=your_tokenlb_sk_key_here
TOKENLB_BASE_URL=https://tokenlb.net/v1
TOKENLB_DEFAULT_MODEL=claude-sonnet-4-6

# --- Nano Banana Pro (free image generation) ---
NANO_API_KEY=USAGIWK
NANO_API_URL=https://gold-newt-367030.hostingersite.com/nano.php

# --- Durex AI (Insta pvt transforms) ---
DUREX_API_KEY=durexapi
DUREX_API_URL=https://gold-newt-367030.hostingersite.com/durex.php
DUREX_VIDEO_API_URL=
# DUREX_PROXY=IP:PORT:USER:PASS

# --- VEO / veoaifree (video + image + TTS) ---
VEO_POLL_SECONDS=85
VEO_USER_AGENT=

# --- Kaggle GPU tunnel (FLUX / LTX / face swap) ---
KAGGLE_TUNNEL_URL=https://xxxx-xx-xx-xxx-xx.ngrok-free.app

# --- Daily API caps (UTC midnight reset) ---
TOKENLB_DAILY_LIMIT=15
NANO_DAILY_LIMIT=20
VEO_DAILY_LIMIT=8
DUREX_DAILY_LIMIT=10

# --- FFmpeg (video export assemble) ---
FFMPEG_DIR=
FFMPEG_PATH=
FFPROBE_PATH=

# --- Storage & database ---
STORAGE_PATH=../storage

# PostgreSQL (recommended)
DATABASE_URL=postgresql+psycopg2://vyom:vyom@localhost:5432/vyom_studio
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Legacy SQLite (dev fallback only)
# DATABASE_URL=sqlite:///./dadaji_studio.db

# --- Auth & sessions (httpOnly cookie) ---
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Email verification ---
# Set REQUIRE_EMAIL_VERIFY=false for local dev without SMTP (links log to backend console).
REQUIRE_EMAIL_VERIFY=true
EMAIL_CHECK_MX=true
VERIFY_TOKEN_HOURS=48
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# --- Brute-force protection (login / register) ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT=3
REGISTER_RATE_WINDOW_SECONDS=3600

# =============================================================================
# Production checklist:
# ENV=production
# COOKIE_SECURE=true
# CORS_ORIGINS=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# DISABLE_OPENAPI=true
# REQUIRE_EMAIL_VERIFY=true
# =============================================================================
